{
  "version": 2,
  "builds": [
    { 
      "src": "api/contact.js", 
      "use": "@vercel/node",
      "config": {
        "maxDuration": 10
      }
    },
    { 
      "src": "api/join.js", 
      "use": "@vercel/node",
      "config": {
        "maxDuration": 10
      }
    },
    { 
      "src": "api/health.js", 
      "use": "@vercel/node",
      "config": {
        "maxDuration": 5
      }
    },
    { "src": "frontend/package.json", "use": "@vercel/static-build", "config": { "distDir": "frontend/dist" } }
  ],
  "routes": [
    { "src": "/api/contact", "dest": "/api/contact.js" },
    { "src": "/api/join", "dest": "/api/join.js" },
    { "src": "/api/health", "dest": "/api/health.js" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/frontend/dist/index.html" }
  ]
}
