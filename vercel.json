{
  "version": 2,

  "functions": {
    "api/contact.js": {
      "runtime": "nodejs18.x",
      "maxDuration": 10
    },
    "api/health.js": {
      "runtime": "nodejs18.x",
      "maxDuration": 5
    }
  },

  "routes": [
    { "src": "/api/contact", "dest": "/api/contact.js" },
    { "src": "/api/health", "dest": "/api/health.js" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/frontend/dist/index.html" }
  ]
}
